# ===========================================
# PayLoad Frontend Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in your values

# Thirdweb Configuration
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your_thirdweb_client_id

# Alchemy API Keys (for multi-chain wallet analysis)
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key
ALCHEMY_API_KEY=your_alchemy_api_key

# AI Service API Keys
GROQ_API_KEY=your_groq_api_key
PERPLEXITY_API_KEY=your_perplexity_api_key
CHAINGPT_API_KEY=your_chaingpt_api_key

# Agent Wallet (for signing EIP-712 attestations)
AGENT_WALLET_ADDRESS=your_agent_wallet_address
PRIVATE_KEY=your_agent_private_key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Smart Contract Addresses (Sepolia Testnet)
NEXT_PUBLIC_CREDENTIAL_NFT_ADDRESS=0x09f9e2C32eC093C65d0E900DaA3d22da9af3d05F
NEXT_PUBLIC_AUTOMATION_CONSUMER_ADDRESS=0x91c42Cc38904E5fB3Ee02626CC60352860E63F22
NEXT_PUBLIC_CHAIN_ID=11155111

# x402 Payment Configuration
SKIP_PAYMENT_CHECK=false
SERVER_WALLET_ADDRESS=your_server_wallet_address
NEXT_PUBLIC_SERVER_WALLET=your_server_wallet_address
